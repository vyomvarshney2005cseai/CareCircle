# Server Configuration
PORT=8080
NODE_ENV=development

# Security
JWT_SECRET=carecircle-super-secure-secret-key-change-in-production-min32chars
COOKIE_SECRET=carecircle-cookie-secret-key-min32chars

# Data Store (memory | firestore)
DATA_STORE=memory

# Google Cloud / Firestore (required only if DATA_STORE=firestore)
GCP_PROJECT_ID=carecircle-hackathon
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
